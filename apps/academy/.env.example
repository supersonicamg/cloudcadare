# ---- Base domain. Tenants live at <slug>.<BASE_DOMAIN>. Use "localhost" in development
# (demo.localhost:3000 resolves to your machine in modern browsers).
BASE_DOMAIN=localhost

# ---- Supabase project of THIS client (one cloud project per client, see plan/14-delivery-and-hosting.md).
# Leave empty in development to use the built-in "demo" fixture tenant.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Edge domain map for custom domains (Upstash Redis REST). Optional in development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Dev alternative: {"learn.example.com":{"tenantId":"…","slug":"demo","planeId":"pooled-1","frontend":"default","status":"active"}}
EDUCORE_DOMAIN_MAP=

# ---- Display
PLATFORM_NAME=EduCore

# Mux signed playback (only needed for videos whose lesson says "signed policy").
# Create a signing key in the Mux dashboard; the private key is the base64 string Mux shows once.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ---- Dev/test only: a built-in fake payment gateway (fixed public keys, no network). Ignored when NODE_ENV=production.
# Never set this on a server that takes real payments.
EDUCORE_FAKE_GATEWAY=

# ---- Email (receipts, refunds, certificates). RESEND_API_KEY set: sends through Resend (the sending domain must be verified there).
# Not set: in development mail goes to the local mail sink (pnpm mail:sink, port 54325); in production nothing is sent and each
# attempt is recorded as "email_not_configured" in message_deliveries.
RESEND_API_KEY=
# Address mail is sent from (the academy's name is added in front). Default: noreply@<BASE_DOMAIN>.
EMAIL_FROM_ADDRESS=
# Bearer secret for GET /api/cron/outbox, which a scheduler calls every minute or so to send queued mail. Without it the route is a 404.
CRON_SECRET=
