# Direct Postgres connection to the control plane (server-only; the `control` schema is not exposed via the API).
CONTROL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth for staff and for people redeeming a license key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Where academies live, used to show the address of a new academy.
BASE_DOMAIN=localhost
